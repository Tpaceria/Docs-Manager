<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Docs_Manager.View.DocumentsPage"
    BackgroundColor="#071426"
    Padding="0">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- HEADER -->

        <Border Grid.Row="0"
                BackgroundColor="#0d1b2d"
                StrokeThickness="0"
                Padding="24,18">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="2">

                    <Label
                        Text="Documents Dashboard"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Text="Manage seafarer documents and files"
                        FontSize="13"
                        TextColor="#7f9bb8"/>

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="➕ Add Document"
                    HeightRequest="50"
                    WidthRequest="210"
                    BackgroundColor="#00bfff"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="14"
                    Clicked="OnAddDocumentClicked"/>

            </Grid>

        </Border>

        <!-- STATS -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="14"
            Padding="20,16,20,8">

            <Border
                BackgroundColor="#102544"
                Stroke="#17365d"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="TOTAL"
                        FontSize="11"
                        TextColor="#7f9bb8"/>

                    <Label
                        Text="{Binding Documents.Count}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"/>

                </VerticalStackLayout>

            </Border>

            <Border
                Grid.Column="1"
                BackgroundColor="#102544"
                Stroke="#17365d"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="FILES"
                        FontSize="11"
                        TextColor="#7f9bb8"/>

                    <Label
                        Text="DOC"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#28d17c"/>

                </VerticalStackLayout>

            </Border>

            <Border
                Grid.Column="2"
                BackgroundColor="#102544"
                Stroke="#17365d"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="ACTIVE"
                        FontSize="11"
                        TextColor="#7f9bb8"/>

                    <Label
                        Text="OK"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#00bfff"/>

                </VerticalStackLayout>

            </Border>

            <Border
                Grid.Column="3"
                BackgroundColor="#102544"
                Stroke="#17365d"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="ARCHIVE"
                        FontSize="11"
                        TextColor="#7f9bb8"/>

                    <Label
                        Text="SAFE"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#ffb020"/>

                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- SEARCH -->

        <Border
            Grid.Row="2"
            Margin="20,0,20,14"
            BackgroundColor="#102544"
            Stroke="#17365d"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14"
            Padding="12,4">

            <Grid ColumnDefinitions="Auto,*">

                <Label
                    Text="🔍"
                    VerticalOptions="Center"
                    FontSize="16"
                    Margin="4,0,10,0"/>

                <SearchBar
                    x:Name="SearchBar"
                    Grid.Column="1"
                    Placeholder="Search documents..."
                    PlaceholderColor="#7f9bb8"
                    TextColor="White"
                    BackgroundColor="Transparent"/>

            </Grid>

        </Border>

        <!-- DOCUMENTS -->

        <CollectionView
            x:Name="DocumentsCollectionView"
            Grid.Row="3"
            ItemsSource="{Binding Documents}"
            SelectionMode="None"
            Margin="18,0,18,18"
            EmptyView="No documents">

            <CollectionView.ItemsLayout>

                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="12"/>

            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
        BackgroundColor="#102544"
        Stroke="#17365d"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        Padding="18">

                        <VerticalStackLayout Spacing="4">

                            <!-- TITLE -->

                            <Label
                Text="{Binding Title}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"/>

                            <!-- INFO -->


                            <Grid
    ColumnDefinitions="2*,1.5*,1.8*,1.8*,Auto"
    ColumnSpacing="18">
                                <!-- Country -->

                                <Label
                    Grid.Column="0"
                    Text="{Binding Country}"
                    FontSize="13"
                    TextColor="#8fb3d9"
                    VerticalOptions="Center"/>

                                <!-- Number -->

                                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    VerticalOptions="Center">

                                    <Label
                        Text="No."
                        FontAttributes="Bold"
                        FontSize="13"
                        TextColor="#8fb3d9"/>

                                    <Label
                        Text="{Binding Number}"
                        FontSize="13"
                        TextColor="White"/>

                                </HorizontalStackLayout>

                                <!-- Issue -->

                                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="4"
                    VerticalOptions="Center">

                                    <Label
                        Text="Issued"
                        FontAttributes="Bold"
                        FontSize="13"
                        TextColor="#8fb3d9"/>

                                    <Label
                        Text="{Binding IssueDate,StringFormat='{0:dd.MM.yyyy}'}"
                        FontSize="13"
                        TextColor="White"/>

                                </HorizontalStackLayout>

                                <!-- Expiry -->

                                <HorizontalStackLayout
                    Grid.Column="3"
                    Spacing="4"
                    VerticalOptions="Center">

                                    <Label
                        Text="Expiry"
                        FontAttributes="Bold"
                        FontSize="13"
                        TextColor="#8fb3d9"/>

                                    <Label
                        Text="{Binding ExpiryDate,StringFormat='{0:dd.MM.yyyy}'}"
                        FontSize="13"
                        TextColor="White"/>

                                </HorizontalStackLayout>

                                <!-- Buttons -->

                                <HorizontalStackLayout
                    Grid.Column="4"
                    Spacing="8"
                    HorizontalOptions="End">

                                    <Button
                        Text="👁"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="12"
                        BackgroundColor="#00bfff"
                        TextColor="White"
                        FontSize="14"
                        Clicked="OnViewDocumentClicked"
                        CommandParameter="{Binding .}"/>

                                    <Button
                        Text="✏"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="12"
                        BackgroundColor="#ffb020"
                        TextColor="Black"
                        FontSize="14"
                        Clicked="OnEditDocumentClicked"
                        CommandParameter="{Binding .}"/>

                                    <Button
                        Text="🗑"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="12"
                        BackgroundColor="#ff4d6d"
                        TextColor="White"
                        FontSize="14"
                        Clicked="OnDeleteDocumentClicked"
                        CommandParameter="{Binding .}"/>

                                </HorizontalStackLayout>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentView>