<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Docs_Manager.View.PersonalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#071a2f">

    <ScrollView>

        <Grid
            Padding="10"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ===================================== -->
            <!-- LEFT COLUMN -->
            <!-- ===================================== -->

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="10">

                <!-- HEADER -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <Grid
                        ColumnDefinitions="130,4.2*,2.8*"
                        ColumnSpacing="12">

                        <!-- PHOTO -->

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="6">

                            <Frame
                                WidthRequest="110"
                                HeightRequest="140"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="#1a2238"
                                BorderColor="#2d4d73"
                                HasShadow="False">

                                <Image
                                    x:Name="PhotoImage"
                                    Aspect="AspectFill"/>

                            </Frame>

                            <Button
                                x:Name="EditButton"
                                Text="✏️ EDIT"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="11"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                FontAttributes="Bold"
                                Clicked="OnEditMainProfileClicked"/>

                            <Button
                                x:Name="PickPhotoButton"
                                Text="Choose Photo"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="11"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnPickPhotoClicked"/>

                            <Button
                                x:Name="SaveButton"
                                Text="💾 SAVE PROFILE"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="11"
                                BackgroundColor="#28a745"
                                TextColor="White"
                                FontAttributes="Bold"
                                IsVisible="False"
                                Clicked="OnSaveClicked"/>

                        </VerticalStackLayout>

                        <!-- PROFILE -->

                        <Grid
                            Grid.Column="1"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnSpacing="20"
                            RowSpacing="8">

                            <!-- FIRST NAME -->
                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="First Name"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="FirstNameLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="FirstNameEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- NATIONALITY -->
                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="Nationality"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="NationalityLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="NationalityEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- MIDDLE NAME -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Middle Name"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="MiddleNameLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="MiddleNameEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- PLACE OF BIRTH -->
                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="Place of Birth"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="PlaceOfBirthLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="PlaceOfBirthEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- LAST NAME -->
                            <VerticalStackLayout
                                Grid.Row="2"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Last Name"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="LastNameLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="LastNameEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- CITIZENSHIP -->
                            <VerticalStackLayout
                                Grid.Row="2"
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="Citizenship"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="CitizenshipLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Entry
                                    x:Name="CitizenshipEntry"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- DATE OF BIRTH -->
                            <VerticalStackLayout
                                Grid.Row="3"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Date of Birth"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="BirthDateLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <DatePicker
                                    x:Name="BirthDatePicker"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                            <!-- GENDER -->
                            <VerticalStackLayout
                                Grid.Row="3"
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="Gender"
                                    FontSize="12"
                                    TextColor="#5a7a99"/>

                                <!-- View Mode -->
                                <Label
                                    x:Name="GenderLabel"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#ffffff"
                                    IsVisible="True"/>

                                <!-- Edit Mode -->
                                <Picker
                                    x:Name="GenderPicker"
                                    HeightRequest="30"
                                    FontSize="16"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                            </VerticalStackLayout>

                        </Grid>

                    </Grid>

                </Border>

                <!-- EXPERIENCE -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="⚙ EXPERIENCE"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#ff8c42"/>

                        <!-- TABLE HEADER -->

                        <Grid Padding="0,0,0,6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Column="0"
                                Text="Vessel"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="1"
                                Text="Flag"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="2"
                                Text="Rank"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="3"
                                Text="Type of Vessel"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="4"
                                Text="DWT"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="End"/>

                            <Label
                                Grid.Column="5"
                                Text="Period"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="End"/>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#224b75"
                            Opacity="0.8"
                            Margin="0,0,0,6"/>

                        <VerticalStackLayout
                            x:Name="ExperiencePreviewContainer"
                            Spacing="4"/>

                    </VerticalStackLayout>

                </Border>

                <!-- COC TABLE -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="📘 COC"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#ff8c42"/>

                        <!-- TABLE HEADER -->

                        <Grid Padding="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Column="0"
                                Text="Document"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="1"
                                Text="Number"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"/>

                            <Label
                                Grid.Column="2"
                                Text="Expiry"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"/>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#224b75"
                            Opacity="0.45"
                            Margin="0,0,0,6"/>

                        <VerticalStackLayout
                            x:Name="CocPreviewContainer"
                            Spacing="4"/>

                    </VerticalStackLayout>

                </Border>

                <!-- CERTIFICATES -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="📜 CERTIFICATES"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#ff8c42"/>

                        <Grid Padding="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Column="0"
                                Text="Document"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"/>

                            <Label
                                Grid.Column="1"
                                Text="Country"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"/>

                            <Label
                                Grid.Column="2"
                                Text="Expiry"
                                FontAttributes="Bold"
                                TextColor="#19b5ea"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"/>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#224b75"
                            Opacity="0.45"
                            Margin="0,0,0,6"/>

                        <VerticalStackLayout
                            x:Name="CertificatesPreviewContainer"
                            Spacing="4"/>

                    </VerticalStackLayout>

                        </Border>

                <!-- DOCUMENTS -->

                <Border
                     BackgroundColor="#102844"
                     Stroke="#173b63"
                     StrokeShape="RoundRectangle 10"
                     Padding="8">

                    <VerticalStackLayout Spacing="6">

                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                Text="📄 DOCUMENTS"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#ff8c42"
                VerticalOptions="Center"/>

                           
                        </Grid>

                        <!-- Table Header -->
                        <VerticalStackLayout
        x:Name="DocumentsHeaderContainer"
        Spacing="0"/>

                        <BoxView
        HeightRequest="1"
        BackgroundColor="#224b75"
        Opacity="0.45"
        Margin="0,0,0,6"/>

                        <!-- Rows -->
                        <VerticalStackLayout
        x:Name="DocumentsPreviewContainer"
        Spacing="4"/>

                    </VerticalStackLayout>
                </Border>
                
            </VerticalStackLayout>
            <!-- ===================================== -->
            <!-- RIGHT COLUMN -->
            <!-- ===================================== -->

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="10">

                <!-- CONTACTS -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="📞 CONTACTS"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#ff8c42"/>

                            <Button
                                x:Name="EditContactsButton"
                                Grid.Column="1"
                                Text="Edit"
                                WidthRequest="55"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="12"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnEditContactsClicked"/>

                        </Grid>

                        <VerticalStackLayout
                            x:Name="ContactsPreviewContainer"
                            Spacing="6"/>

                    </VerticalStackLayout>

                </Border>

                <!-- EDUCATION -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="🎓 EDUCATION"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#ff8c42"/>

                            <Button
                                x:Name="EditEducationButton"
                                Grid.Column="1"
                                Text="Edit"
                                HeightRequest="28"
                                WidthRequest="60"
                                CornerRadius="6"
                                FontSize="12"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnEditEducationClicked"/>

                        </Grid>

                        <VerticalStackLayout
                            x:Name="EducationPreviewContainer"
                            Spacing="6"/>

                    </VerticalStackLayout>

                </Border>

                <!-- SKILLS & LANGUAGES -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="🌍 SKILLS &amp; LANGUAGES"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#ff8c42"/>

                            <Button
                                x:Name="EditSkillsButton"
                                Grid.Column="1"
                                Text="Edit"
                                WidthRequest="55"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="12"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnEditSkillsClicked"/>

                        </Grid>

                        <VerticalStackLayout
                            x:Name="SkillsPreviewContainer"
                            Spacing="6"/>

                    </VerticalStackLayout>

                </Border>

                <!-- BIOMETRIC -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="🧬 BIOMETRIC"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#ff8c42"/>

                            <Button
                                x:Name="EditBiometricButton"
                                Grid.Column="1"
                                Text="Edit"
                                WidthRequest="55"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="12"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnEditBiometricClicked"/>

                        </Grid>

                        <VerticalStackLayout
                            x:Name="BiometricPreviewContainer"
                            Spacing="6"/>

                    </VerticalStackLayout>

                </Border>

                <!-- NEXT OF KIN -->

                <Border
                    BackgroundColor="#102844"
                    Stroke="#173b63"
                    StrokeShape="RoundRectangle 10"
                    Padding="8">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="👨‍👩‍👧 NEXT OF KIN"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#ff8c42"/>

                            <Button
                                x:Name="EditNextOfKinButton"
                                Grid.Column="1"
                                Text="Edit"
                                WidthRequest="56"
                                HeightRequest="28"
                                CornerRadius="6"
                                FontSize="12"
                                BackgroundColor="#19b5ea"
                                TextColor="White"
                                IsVisible="False"
                                Clicked="OnEditNextOfKinClicked"/>

                        </Grid>

                        <VerticalStackLayout
                            x:Name="NextOfKinPreviewContainer"
                            Spacing="6"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentView>
