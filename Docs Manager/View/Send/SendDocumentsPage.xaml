<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Docs_Manager.View.SendDocumentsPage"
             BackgroundColor="#071a2f">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="15">

        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="📨 Отправить"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#00d4ff"/>
            <Label Text="Выберите файлы для отправки"
                   FontSize="14"
                   TextColor="#7a8999"/>
        </VerticalStackLayout>

        <Label x:Name="EmptyLabel"
               Grid.Row="1"
               Text="Нет доступных файлов"
               TextColor="#7a8999"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False"/>

        <CollectionView x:Name="FilesView" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#102844"
                            Stroke="#173b63"
                            StrokeShape="RoundRectangle 10"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <CheckBox Grid.Column="0"
                                      VerticalOptions="Center"
                                      CheckedChanged="OnFileCheckedChanged"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding FileName}"
                                       FontSize="14"
                                       TextColor="#ffffff"/>
                                <Label Text="{Binding FileSizeDisplay}"
                                       FontSize="12"
                                       TextColor="#7a8999"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Далее"
                BackgroundColor="#00d4ff"
                TextColor="#071a2f"
                FontAttributes="Bold"
                HeightRequest="45"
                Clicked="OnNextClicked"/>

    </Grid>

</ContentView>
