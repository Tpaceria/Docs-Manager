<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Docs_Manager.View.SendMethodPage"
             BackgroundColor="#071a2f">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <VerticalStackLayout Spacing="5">
                <Label Text="Отправить с помощью:"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#00d4ff"/>
                <Label x:Name="SummaryLabel"
                       FontSize="14"
                       TextColor="#7a8999"/>
            </VerticalStackLayout>

            <Button Text="📧 Почта"
                    BackgroundColor="#102844"
                    TextColor="White"
                    HeightRequest="50"
                    Clicked="OnEmailClicked"/>
            <Button Text="💬 Мессенджер"
                    BackgroundColor="#102844"
                    TextColor="White"
                    HeightRequest="50"
                    Clicked="OnMessengerClicked"/>
            <Button Text="🗜️ Создать архив"
                    BackgroundColor="#102844"
                    TextColor="White"
                    HeightRequest="50"
                    Clicked="OnArchiveClicked"/>
            <Button Text="💾 USB"
                    BackgroundColor="#102844"
                    TextColor="White"
                    HeightRequest="50"
                    Clicked="OnUsbClicked"/>

            <Button Text="← Назад"
                    BackgroundColor="#6c757d"
                    TextColor="White"
                    HeightRequest="45"
                    Margin="0,10,0,0"
                    Clicked="OnBackClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
