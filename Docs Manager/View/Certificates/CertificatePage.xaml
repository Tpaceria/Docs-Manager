<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Docs_Manager.View.CertificatePage"
             BackgroundColor="#071426"
             Padding="0">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="#0d1b2d"
                StrokeThickness="0"
                Padding="24,18">

            <Grid ColumnDefinitions="*">

                <VerticalStackLayout Spacing="2">

                    <Label Text="Certificates Dashboard"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <Label Text="Manage seafarer certificates and expirations"
                           FontSize="13"
                           TextColor="#7f9bb8"/>

                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="➕ Add Certificate"
                        HeightRequest="50"
                        WidthRequest="220"
                        BackgroundColor="#00bfff"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14"
                        Clicked="OnAddCertificateClicked"/>

            </Grid>
        </Border>

        <!-- STATS -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="14"
              Padding="20,16,20,8">

            <!-- TOTAL -->
            <Border BackgroundColor="#102544"
                    Stroke="#17365d"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label Text="TOTAL"
                           FontSize="11"
                           TextColor="#7f9bb8"/>

                    <Label Text="{Binding Certificates.Count}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"/>

                </VerticalStackLayout>
            </Border>

            <!-- ACTIVE -->
            <Border Grid.Column="1"
                    BackgroundColor="#102544"
                    Stroke="#17365d"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label Text="ACTIVE"
                           FontSize="11"
                           TextColor="#7f9bb8"/>

                    <Label Text="OK"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#28d17c"/>

                </VerticalStackLayout>
            </Border>

            <!-- EXPIRING -->
            <Border Grid.Column="2"
                    BackgroundColor="#102544"
                    Stroke="#17365d"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label Text="EXPIRING"
                           FontSize="11"
                           TextColor="#7f9bb8"/>

                    <Label Text="!"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#ffb020"/>

                </VerticalStackLayout>
            </Border>

            <!-- EXPIRED -->
            <Border Grid.Column="3"
                    BackgroundColor="#102544"
                    Stroke="#17365d"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">

                <VerticalStackLayout Spacing="4">

                    <Label Text="EXPIRED"
                           FontSize="11"
                           TextColor="#7f9bb8"/>

                    <Label Text="X"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#ff4d6d"/>

                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="2"
                Margin="20,0,20,14"
                BackgroundColor="#102544"
                Stroke="#17365d"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                Padding="12,4">

            <Grid ColumnDefinitions="Auto,*">

                <Label Text="🔍"
                       VerticalOptions="Center"
                       FontSize="16"
                       Margin="4,0,10,0"/>

                <SearchBar Grid.Column="1"
                           x:Name="SearchBar"
                           Placeholder="Search certificates..."
                           PlaceholderColor="#7f9bb8"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchTextChanged"/>

            </Grid>
        </Border>

        <!-- LIST -->
        <RefreshView Grid.Row="3"
                     x:Name="CertificateRefreshView"
                     Refreshing="OnRefreshing">

            <CollectionView x:Name="CertificateCollectionView"
                            ItemsSource="{Binding Certificates}"
                            SelectionMode="None"
                            Margin="18,0,18,18">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>


                    <DataTemplate>

                        <Border
        BackgroundColor="#102544"
        Stroke="#17365d"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        Padding="18">

                            <Grid
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="*">

                                <!-- LEFT -->

                                <VerticalStackLayout Spacing="10">

                                    <!-- TITLE -->

                                    <Label
                    Text="{Binding Document}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"/>

                                    <!-- INFO -->

                                    <Grid
                    ColumnDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="22">

                                        <!-- Country -->

                                        <Label
                        Grid.Column="0"
                        Text="{Binding Country}"
                        FontSize="13"
                        TextColor="#8fb3d9"
                        VerticalOptions="Center"/>

                                        <!-- Number -->

                                        <HorizontalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                                            <Label
                            Text="No."
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#8fb3d9"/>

                                            <Label
                            Text="{Binding Number}"
                            FontSize="13"
                            TextColor="White"/>

                                        </HorizontalStackLayout>

                                        <!-- Issued -->

                                        <HorizontalStackLayout
                        Grid.Column="2"
                        Spacing="4">

                                            <Label
                            Text="Issued"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#8fb3d9"/>

                                            <Label
                            Text="{Binding IssueDate,StringFormat='{0:dd.MM.yyyy}'}"
                            FontSize="13"
                            TextColor="White"/>

                                        </HorizontalStackLayout>

                                        <!-- Expiry -->

                                        <HorizontalStackLayout
                        Grid.Column="3"
                        Spacing="4">

                                            <Label
                            Text="Expiry"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#8fb3d9"/>

                                            <Label
                            Text="{Binding ExpiryDate,StringFormat='{0:dd.MM.yyyy}'}"
                            FontSize="13"
                            TextColor="White"/>

                                        </HorizontalStackLayout>

                                    </Grid>

                                </VerticalStackLayout>

                                <!-- STATUS -->


                                <!-- ACTIONS -->

                                <HorizontalStackLayout
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalOptions="End"
                Spacing="8"
                Margin="0,18,0,0">

                                    <Button
                    Text="👁"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="14"
                    BackgroundColor="#00bfff"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnViewCertificateClicked"
                    CommandParameter="{Binding .}"/>

                                    <Button
                    Text="✏"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="14"
                    BackgroundColor="#ffb020"
                    TextColor="Black"
                    CornerRadius="12"
                    Clicked="OnEditClicked"
                    CommandParameter="{Binding .}"/>

                                    <Button
                    Text="🗑"
                    WidthRequest="40"
                    HeightRequest="40"
                    FontSize="14"
                    BackgroundColor="#ff4d6d"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnDeleteCertificateClicked"
                    CommandParameter="{Binding .}"/>

                                </HorizontalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>
                    
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentView>