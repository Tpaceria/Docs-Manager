<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Docs_Manager.View.NotesAndCommentsPage"
             BackgroundColor="#071a2f">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="5">
                <Label Text="📝 Заметки"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#00d4ff"/>
                <Label Text="Notes and comments"
                       FontSize="14"
                       TextColor="#7a8999"/>
            </VerticalStackLayout>

            <!-- ADD NOTE BUTTON -->
            <Button Text="+ Добавить заметку"
                    BackgroundColor="#19b5ea"
                    TextColor="White"
                    HeightRequest="45"
                    Clicked="OnAddNoteClicked"/>

            <!-- NOTES CONTAINER -->
            <VerticalStackLayout x:Name="NotesContainer"
                                Spacing="10"/>

            <!-- PLACEHOLDER -->
            <VerticalStackLayout Spacing="10"
                                Padding="20"
                                BackgroundColor="#0f1f2e"
                                Margin="0,20,0,0">
                <Label Text="Нет заметок"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#ff8c42"
                       HorizontalOptions="Center"/>
                <Label Text="Добавьте первую заметку"
                       FontSize="12"
                       TextColor="#7a8999"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>