<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Docs_Manager.Controls.DateSelector"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <HorizontalStackLayout
        Spacing="8">

        <Border
            StrokeShape="RoundRectangle 6"
            Stroke="#1a3a52"
            StrokeThickness="1"
            BackgroundColor="#1a3a52">

            <Picker
                x:Name="DayPicker"
                WidthRequest="70"
                Title="DD"
                BackgroundColor="Transparent"
                TextColor="#ffffff"
                TitleColor="#7a8999" />

        </Border>

        <Border
            StrokeShape="RoundRectangle 6"
            Stroke="#1a3a52"
            StrokeThickness="1"
            BackgroundColor="#1a3a52">

            <Picker
                x:Name="MonthPicker"
                WidthRequest="70"
                Title="MM"
                BackgroundColor="Transparent"
                TextColor="#ffffff"
                TitleColor="#7a8999" />

        </Border>

        <Border
            StrokeShape="RoundRectangle 6"
            Stroke="#1a3a52"
            StrokeThickness="1"
            BackgroundColor="#1a3a52">

            <Picker
                x:Name="YearPicker"
                WidthRequest="100"
                Title="YYYY"
                BackgroundColor="Transparent"
                TextColor="#ffffff"
                TitleColor="#7a8999" />

        </Border>

    </HorizontalStackLayout>

</ContentView>
